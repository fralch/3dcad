@baseUrl = http://127.0.0.1:8000
@camionId = 1

###
GET {{baseUrl}}/api/camiones/placas
Accept: application/json

###
GET {{baseUrl}}/api/camiones
Accept: application/json

###
POST {{baseUrl}}/api/camiones
Accept: application/json
Content-Type: application/json

{
  "placa": "API-123",
  "marca": "Volvo",
  "modelo": "FH16",
  "anio": 2024,
  "capacidad_carga": 20.5,
  "estado": "activo",
  "conductor_asignado": "Juan Perez",
  "observaciones": "Registro desde archivo HTTP"
}

###
GET {{baseUrl}}/api/camiones/{{camionId}}
Accept: application/json

###
PUT {{baseUrl}}/api/camiones/{{camionId}}
Accept: application/json
Content-Type: application/json

{
  "placa": "API-123",
  "marca": "Volvo",
  "modelo": "FH16 EVO",
  "anio": 2025,
  "capacidad_carga": 21,
  "estado": "mantenimiento",
  "conductor_asignado": "Pedro Alvarez",
  "observaciones": "Actualización desde archivo HTTP"
}

###
DELETE {{baseUrl}}/api/camiones/{{camionId}}
Accept: application/json
